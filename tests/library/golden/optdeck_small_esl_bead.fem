$ ESL bead topography deck (OptiStruct 2026.1, free format for optimization cards)
$ generated by esl.library.optdeck; nodes/elements = Radioss IDs; generated IDs from 501
$ confidence (not executed by generator): mesh/FORCE/SPC1 cards = high
$ confidence (not executed by generator): DTPG bead line (MW ANG BF HGT NORM - - SKIP, no flag; BOUNDS LB UB) = medium-high
$ confidence (not executed by generator): DRESP1 COMP = high
$ confidence (not executed by generator): DESOBJ(MINMAX) + DOBJREF (ID DRESP NEG POS LOADSUB) = medium-high
$ confidence (not executed by generator): WCOMP + subcase WEIGHT = medium
$ confidence (not executed by generator): BEADFRAC response = medium-low
$ confidence (not executed by generator): free-format continuation '+,' = medium-high (regenerate with card_format: fixed if rejected)
DESOBJ(MINMAX) = 510
DISPLACEMENT(H3D) = ALL
SPCFORCE(H3D) = ALL
SUBCASE 1
  LABEL REP1_Corner146
  SPC = 501
  LOAD = 502
SUBCASE 2
  LABEL REP2_Face3
  SPC = 501
  LOAD = 503
BEGIN BULK
